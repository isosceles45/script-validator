# Which provider backs the LLM + embedding calls: "openai" | "gemini"
PROVIDER=openai

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_LLM_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-large

# --- Gemini ---
GOOGLE_API_KEY=
GEMINI_LLM_MODEL=gemini-2.0-flash
GEMINI_EMBED_MODEL=text-embedding-004

# --- storage ---
DATA_DIR=./data
DB_PATH=./data/store.sqlite3

# --- retrieval ---
TOP_K=5
CHUNK_TOKENS=500
CHUNK_OVERLAP=0.15
# Drop chunks with less content than this. Slide decks are full of "THE END",
# "Thank you" and title fragments; BM25 normalises by length, so a 7-char chunk
# containing a query term outranks the real evidence.
MIN_CHUNK_CHARS=40
MIN_SIMILARITY=0.25

# --- scoring weights (must sum to 1.0) ---
W_BRIEF=0.30
W_MESSAGE=0.25
W_CLAIMS=0.45

# --- eval ---
GOLDEN_SAMPLE_SIZE=8

LOG_LEVEL=INFO
